{
  "name": "@uvp-eth/uvp-client",
  "version": "0.1.0",
  "private": true,
  "description": "Public UVP client: core, browser, headless SDK entries and the executor CLI.",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "uvp-client": "./dist/cli/index.js"
  },
  "exports": {
    "./core": "./src/core/index.ts",
    "./browser": "./src/browser/index.ts",
    "./headless": "./src/headless/index.ts",
    "./cli": "./src/cli/index.ts"
  },
  "files": [
    "src",
    "dist",
    "fixtures",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm build",
    "test": "vitest run && tsx --test \"tests/**/*.node.test.ts\"",
    "test:watch": "vitest",
    "dev": "tsx src/cli/index.ts",
    "cli": "tsx src/cli/index.ts"
  },
  "dependencies": {
    "@uvp-eth/canonical-json": "workspace:*",
    "@uvp-eth/compiler": "workspace:*",
    "@uvp-eth/product-dto": "workspace:*",
    "@uvp-eth/protocol-bindings": "workspace:*",
    "@uvp-eth/zhixu-registry": "workspace:*",
    "commander": "^12.1.0",
    "viem": "^2.21.58"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
